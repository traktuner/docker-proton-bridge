[Unit]
Description=ProtonMail Bridge (Docker + Tailscale sidecar)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/projects/protonmail-bridge-docker-arm64-tailscale
ExecStart=%h/projects/protonmail-bridge-docker-arm64-tailscale/start.sh
ExecStop=/usr/bin/docker compose -f %h/projects/protonmail-bridge-docker-arm64-tailscale/docker/docker-compose.yml down

[Install]
WantedBy=default.target
